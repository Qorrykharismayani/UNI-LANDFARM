generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int              @id @default(autoincrement())
  name             String
  email            String           @unique
  password         String?
  role             String
  status           String           @default("Aktif")
  provider         String           @default("credentials")
  image            String?
  phone            String?
  location         String?
  plan             String           @default("Regular Access")
  tokens           Int              @default(0)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  landingPages     LandingPage[]
  mediaFiles       MediaFile[]
  notifications    Notification[]
  reviewedRequests PublishRequest[] @relation("ReviewedByAdmin")
  articles         Article[]
  transactions     Transaction[]

  @@map("users")
}

model Template {
  id             Int           @id @default(autoincrement())
  name           String        @unique @map("nama_template")
  category       String        @map("kategori")
  description    String        @map("deskripsi")
  thumbnail      String
  structureJson  Json          @map("struktur_section")
  defaultContent Json?         @map("default_content")
  status         String        @default("Aktif") @map("status_template")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  landingPages   LandingPage[]

  @@map("templates")
}

model LandingPage {
  id              Int              @id @default(autoincrement())
  userId          Int
  templateId      Int
  title           String
  businessName    String
  slug            String           @unique
  status          String           @default("Draft")
  views           Int              @default(0)
  publicUrl       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  publishedAt     DateTime?
  domain          Domain?
  template        Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaFiles      MediaFile[]
  publishRequests PublishRequest[]
  content         TemplateSection?

  @@index([templateId], map: "landing_pages_templateId_fkey")
  @@index([userId], map: "landing_pages_userId_fkey")
  @@map("landing_pages")
}

model TemplateSection {
  id            Int         @id @default(autoincrement())
  landingPageId Int         @unique
  contentJson   Json
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@map("template_sections")
}

model PublishRequest {
  id              Int         @id @default(autoincrement())
  landingPageId   Int
  requestedBy     Int
  reviewedBy      Int?
  status          String      @default("Pending")
  rejectionReason String?
  requestedAt     DateTime    @default(now())
  reviewedAt      DateTime?
  landingPage     LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  admin           User?       @relation("ReviewedByAdmin", fields: [reviewedBy], references: [id])

  @@index([landingPageId], map: "publish_requests_landingPageId_fkey")
  @@index([reviewedBy], map: "publish_requests_reviewedBy_fkey")
  @@map("publish_requests")
}

model MediaFile {
  id            Int          @id @default(autoincrement())
  userId        Int
  landingPageId Int?
  fileName      String
  fileUrl       String
  fileType      String
  createdAt     DateTime     @default(now())
  landingPage   LandingPage? @relation(fields: [landingPageId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([landingPageId], map: "media_files_landingPageId_fkey")
  @@index([userId], map: "media_files_userId_fkey")
  @@map("media_files")
}

model SystemSetting {
  id               Int      @id @default(autoincrement())
  platformName     String
  logo             String
  heroTitle        String
  heroDescription  String
  contactEmail     String
  whatsapp         String
  socialLinksJson  Json
  footerText       String
  featuresJson     Json?
  testimonialsJson Json?
  faqsJson         Json?
  userPageJson     Json?
  updatedAt        DateTime @updatedAt

  @@map("system_settings")
}

model Domain {
  id            Int         @id @default(autoincrement())
  landingPageId Int         @unique
  domainName    String      @unique
  status        String      @default("Active")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@map("domains")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "notifications_userId_fkey")
  @@map("notifications")
}

model Article {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  status      String   @default("Draft")
  author      String
  scoreBefore Int      @default(0)
  scoreAfter  Int      @default(0)
  date        DateTime @default(now())
  type        String   @default("Blog Post")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "articles_userId_fkey")
  @@map("articles")
}

model Transaction {
  id            Int      @id @default(autoincrement())
  userId        Int
  packageName   String
  packageTokens Int
  amount        Int
  method        String
  refId         String   @unique
  status        String   @default("berhasil")
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "transactions_userId_fkey")
  @@map("transactions")
}
