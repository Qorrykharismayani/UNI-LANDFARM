datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  password            String?
  role                String               // "USER" or "ADMIN"
  status              String               @default("Aktif") // "Aktif" or "Nonaktif"
  provider            String               @default("credentials")
  image               String?
  phone               String?
  location            String?
  plan                String               @default("Regular Access")
  tokens              Int                  @default(0)
  resetToken          String?
  resetTokenExpiry    DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  landingPages        LandingPage[]
  reviewedRequests    PublishRequest[]     @relation("ReviewedByAdmin")
  mediaFiles          MediaFile[]
  notifications       Notification[]

  @@map("users")
}

model Template {
  id             String        @id @default(cuid())
  name           String        @map("nama_template")
  category       String        @map("kategori")
  description    String        @map("deskripsi")
  thumbnail      String
  structureJson  Json          @map("struktur_section")
  defaultContent Json?         @map("default_content")
  status         String        @default("Aktif") @map("status_template")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  landingPages   LandingPage[]

  @@map("templates")
}

model LandingPage {
  id                  String               @id @default(cuid())
  userId              String
  templateId          String
  title               String
  businessName        String
  slug                String               @unique
  status              String               @default("Draft") // "Draft", "Pending Review", "Published", "Rejected"
  views               Int                  @default(0)
  publicUrl           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  publishedAt         DateTime?
  
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  template            Template             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  content             TemplateSection?
  publishRequests     PublishRequest[]
  mediaFiles          MediaFile[]
  domain              Domain?

  @@map("landing_pages")
}

model TemplateSection {
  id            String      @id @default(cuid())
  landingPageId String      @unique
  contentJson   Json
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@map("template_sections")
}

model PublishRequest {
  id              String      @id @default(cuid())
  landingPageId   String
  requestedBy     String
  reviewedBy      String?
  status          String      @default("Pending") // "Pending", "Approved", "Rejected"
  rejectionReason String?
  requestedAt     DateTime    @default(now())
  reviewedAt      DateTime?
  
  landingPage     LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  admin           User?       @relation("ReviewedByAdmin", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@map("publish_requests")
}

model MediaFile {
  id            String       @id @default(cuid())
  userId        String
  landingPageId String?
  fileName      String
  fileUrl       String
  fileType      String
  createdAt     DateTime     @default(now())
  
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  landingPage   LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)

  @@map("media_files")
}

model SystemSetting {
  id              String   @id @default("default")
  platformName    String
  logo            String
  heroTitle       String
  heroDescription String
  contactEmail    String
  whatsapp        String
  socialLinksJson Json
  footerText      String
  featuresJson     Json?
  testimonialsJson Json?
  faqsJson         Json?
  userPageJson     Json?
  updatedAt       DateTime @updatedAt

  @@map("system_settings")
}

model Domain {
  id            String      @id @default(cuid())
  landingPageId String      @unique
  domainName    String      @unique
  status        String      @default("Active") // "Active", "Pending", "Failed"
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@map("domains")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String   @default("info") // "info", "success", "warning", "error"
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
